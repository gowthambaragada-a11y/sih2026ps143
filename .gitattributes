# Store line endings exactly as-is (no CRLF/LF conversion).
# Disables the "CRLF will be replaced by LF" warnings from git add on Windows.
* -text

# Binary / non-text artifacts must never be line-ending normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.tif binary
*.tiff binary
*.pt binary
*.pth binary
*.pkl binary
*.pyc binary
*.db binary
*.sqlite3 binary
*.npy binary
*.parquet binary