# OILTRACE-AI frontend environment
#
# Base URL of the live OILTRACE-AI backend API (scheme + host + optional port,
# no trailing slash). When set, the dashboard talks to the deployed FastAPI
# service (Render / Railway / Fly.io). When unset, it falls back to the local
# dev backend at http://127.0.0.1:8000.
#
#   - Local dev:            leave unset (default http://127.0.0.1:8000)
#   - Cloud build (Render): VITE_API_BASE_URL=https://your-api.onrender.com
#
# NOTE: for the static GitHub Pages build, leave this unset so the dashboard
# runs in its bundled synthetic-demo mode; Vite bakes the value in at build
# time, so you must rebuild with the value when you deploy a live backend.
VITE_API_BASE_URL=http://127.0.0.1:8000