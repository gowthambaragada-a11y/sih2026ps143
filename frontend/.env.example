# ------------------------------------------------------------------ *
# OILTRACE-AI · frontend environment
# Copy to `.env` and fill in. When Firebase vars are absent the app runs
# Guest / Evaluator demo mode (uploads become local object URLs).
# ------------------------------------------------------------------ *

# Live FastAPI backend (Render/Railway/VPS). When unreachable the frontend
# falls back to Mock Simulation Mode automatically.
VITE_API_BASE_URL=https://oiltrace-api.onrender.com

# Firebase Web App config — Firebase -> Project settings -> General -> SDK.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=